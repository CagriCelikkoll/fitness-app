{
  "expo": {
    "name": "Dinç",
    "slug": "fitness-tracker",
    "scheme": "dinc",
    "version": "0.12.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/46ac6c2a-a221-476f-948d-435673f4f0a4"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dincapp.antrenman",
      "icon": "./assets/brand/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-icon.png",
        "monochromeImage": "./assets/brand/monochrome-icon.png",
        "backgroundColor": "#0A0A0B"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.dincapp.antrenman",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "com.google.android.gms.permission.AD_ID"
      ],
      "versionCode": 5
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash-icon.png",
          "backgroundColor": "#0A0A0B",
          "resizeMode": "contain"
        }
      ],
      "expo-sharing",
      "expo-asset",
      "expo-font",
      "expo-sqlite",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-image",
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/monochrome-icon.png",
          "color": "#D7FF3E"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Salon logosunu seçmek için fotoğraflarına erişim gerekiyor.",
          "cameraPermission": "Salon girişindeki QR kodu okumak için.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Salon girişindeki QR kodu okumak için.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "46ac6c2a-a221-476f-948d-435673f4f0a4"
      }
    },
    "owner": "cagricelikkoll"
  }
}
