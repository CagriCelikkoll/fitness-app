# Gerçek sunucu testleri (v3.2a): AYRI bir Supabase test projesi (dinc-test).
# .env.test'e kopyala ve doldur. .env.test git'e girmez.
# Gerçek projenin değerlerini ASLA yazma: testler .env'deki gerçek proje
# URL'siyle aynıysa çalışmaz (test/integration/guard.mjs).
#
# Project Settings → API Keys / Data API:
SUPABASE_TEST_URL=
# Publishable key (sb_publishable_…) ya da eski anon JWT
SUPABASE_TEST_ANON_KEY=
# Secret key (sb_secret_…) ya da eski service_role JWT. YALNIZCA test/
# altındaki entegrasyon testlerinde kullanılır; uygulamaya hiçbir koşulda girmez.
SUPABASE_TEST_SERVICE_ROLE_KEY=
# Project Settings → Database → Connection string (URI, şifre dahil)
SUPABASE_TEST_DB_URL=
