{
  "expo": {
    "name": "Dinç",
    "slug": "fitness-tracker",
    "scheme": "dinc",
    "version": "0.10.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/46ac6c2a-a221-476f-948d-435673f4f0a4"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dincapp.antrenman"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.dincapp.antrenman",
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "versionCode": 4
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#0f172a",
          "resizeMode": "contain"
        }
      ],
      "expo-sharing",
      "expo-asset",
      "expo-font",
      "expo-sqlite",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "46ac6c2a-a221-476f-948d-435673f4f0a4"
      }
    },
    "owner": "cagricelikkoll"
  }
}
