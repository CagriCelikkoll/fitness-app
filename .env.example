# Supabase (v3.0 hesap ve salon). .env'e kopyala ve doldur.
# Yalnızca anon (public) key. Service role key uygulamaya ASLA girmez.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google ile giriş (0.13). Google Cloud → OAuth "Web application"
# istemcisinin kimliği (…apps.googleusercontent.com). Herkese açık bir
# değer; istemci gizli anahtarı (client secret) yalnızca Supabase paneline
# girer, buraya ve uygulamaya ASLA. Boşsa "Google ile devam et" görünmez.
# Derlemede EAS ortam değişkeninden gelir (.env değil).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
